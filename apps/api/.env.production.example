# Copy to apps/api/.env for a production-like deploy (Railway, or any other host) -- every
# value below is a placeholder; nothing here is safe to actually run with. See DEPLOY.md for
# the full walkthrough of where each of these comes from on Railway specifically.

NODE_ENV=production
PORT=3000

# Railway: reference your Postgres/Redis plugins' own vars instead of typing these by hand --
# in the API service's variables tab: DATABASE_URL = ${{Postgres.DATABASE_URL}},
# REDIS_URL = ${{Redis.REDIS_URL}}. Elsewhere: your managed Postgres/Redis's real connection
# strings.
DATABASE_URL=postgresql://REPLACE_ME:REPLACE_ME@REPLACE_ME:5432/REPLACE_ME
REDIS_URL=redis://REPLACE_ME:6379

# Generate fresh values for all three of these -- the dev placeholders in .env.example are
# committed to this repo and public; using them in anything reachable from the internet
# means anyone who's ever cloned this repo can forge your access tokens.
#   openssl rand -hex 32        -> JWT_ACCESS_SECRET
#   openssl rand -hex 32        -> JWT_REFRESH_SECRET (use a DIFFERENT run of the command --
#                                  same value for both defeats the point of having two)
#   openssl rand -base64 32     -> CREDENTIALS_ENCRYPTION_KEY
JWT_ACCESS_SECRET=REPLACE_ME_64_HEX_CHARS
JWT_REFRESH_SECRET=REPLACE_ME_64_HEX_CHARS_DIFFERENT_FROM_ACCESS
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
CREDENTIALS_ENCRYPTION_KEY=REPLACE_ME_BASE64_32_BYTES

# The deployed frontend's real origin (Netlify/Cloudflare Pages URL, or your custom domain).
# Must be exact -- no trailing slash, no wildcard; the WebSocket gateway reads this same value
# (see SessionsGateway) so getting it wrong breaks HID/video, not just REST CORS.
CORS_ORIGIN=https://REPLACE_ME.netlify.app

AUDIT_FLUSH_INTERVAL_MS=5000
MAX_CONCURRENT_SESSIONS_PER_OPERATOR=3
MEDIA_STREAM_TICKET_TTL_SECONDS=30

# Local disk, under a mounted volume on Railway (see DEPLOY.md's "Known limitations" --
# this is the one that no longer applies there) so it survives redeploys/restarts. Without
# a volume mounted at this path (or its parent), this directory is wiped on every
# redeploy/restart -- fine for a brief demo, not for anything meant to persist. Swap
# SnapshotStorage's implementation for an object-storage-backed one if that's ever needed
# instead of a volume (not built -- see docs/architecture.md's "What's intentionally not
# built").
SNAPSHOT_STORAGE_DIR=./storage/snapshots
SNAPSHOT_INTERVAL_MS=15000

# The exam-support chat's own attachment store (one optional file per message) -- same
# volume-backed-local-disk reasoning as SNAPSHOT_STORAGE_DIR above, deliberately a separate
# subdirectory so the two features' retention/cleanup policies can diverge later. MAX_BYTES
# is a soft, re-checked-per-request ceiling on top of ChatController's own hard interceptor
# limit (25MB) -- lower it here without a redeploy if needed; raising it past 25MB needs a
# code change too.
CHAT_ATTACHMENT_STORAGE_DIR=./storage/chat-attachments
CHAT_ATTACHMENT_MAX_BYTES=10485760

# The nurse's uploaded exam-order documents (pedido médico / laudo anterior) -- same
# volume-backed-local-disk reasoning again, its own subdirectory. Scanned multi-page orders
# run bigger than a chat photo, hence the larger default ceiling.
QUEUE_DOCUMENT_STORAGE_DIR=./storage/queue-documents
QUEUE_DOCUMENT_MAX_BYTES=20971520

SESSION_IDLE_TIMEOUT_MS=600000
IDLE_SWEEP_INTERVAL_MS=60000
DISABLE_HEALTH_POLLER=false

# Password reset emails, via Resend (https://resend.com) -- create an API key and verify a
# sending domain there first. MAIL_FROM's domain must be the one you verified.
MAILER_DRIVER=resend
RESEND_API_KEY=REPLACE_ME
MAIL_FROM=RadLink <no-reply@REPLACE_ME.com>
# The deployed frontend's real origin -- same value as CORS_ORIGIN above in every setup this
# repo actually runs, but kept as its own variable since the two mean different things (one
# is a CORS allowlist, the other is a link-building base) and nothing enforces they stay
# equal if either changes later.
APP_PUBLIC_URL=https://REPLACE_ME.netlify.app
PASSWORD_RESET_TTL_SECONDS=900

# Password policy, history, and rotation -- see packages/shared/src/password-policy.ts.
# PASSWORD_MAX_AGE_DAYS=0 disables expiry entirely (checked in User.isPasswordExpired).
PASSWORD_HISTORY_DEPTH=5
PASSWORD_MAX_AGE_DAYS=90
PASSWORD_CHANGE_TTL_SECONDS=600
# How long an "Enviar Convite Seguro" account-activation link stays redeemable.
INVITE_TTL_SECONDS=86400
# The one timezone "today" means for the nursing day-view's "N Pacientes Hoje" query --
# see packages/shared/src/clinic-day.ts.
CLINIC_TIME_ZONE=America/Sao_Paulo
