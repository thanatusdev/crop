# Copy to apps/api/.env for a production-like deploy (Railway, or any other host) -- every
# value below is a placeholder; nothing here is safe to actually run with. See DEPLOY.md for
# the full walkthrough of where each of these comes from on Railway specifically.

NODE_ENV=production
PORT=3000

# Railway: reference your Postgres/Redis plugins' own vars instead of typing these by hand --
# in the API service's variables tab: DATABASE_URL = ${{Postgres.DATABASE_URL}},
# REDIS_URL = ${{Redis.REDIS_URL}}. Elsewhere: your managed Postgres/Redis's real connection
# strings.
DATABASE_URL=postgresql://REPLACE_ME:REPLACE_ME@REPLACE_ME:5432/REPLACE_ME
REDIS_URL=redis://REPLACE_ME:6379

# Generate fresh values for all three of these -- the dev placeholders in .env.example are
# committed to this repo and public; using them in anything reachable from the internet
# means anyone who's ever cloned this repo can forge your access tokens.
#   openssl rand -hex 32        -> JWT_ACCESS_SECRET
#   openssl rand -hex 32        -> JWT_REFRESH_SECRET (use a DIFFERENT run of the command --
#                                  same value for both defeats the point of having two)
#   openssl rand -base64 32     -> CREDENTIALS_ENCRYPTION_KEY
JWT_ACCESS_SECRET=REPLACE_ME_64_HEX_CHARS
JWT_REFRESH_SECRET=REPLACE_ME_64_HEX_CHARS_DIFFERENT_FROM_ACCESS
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
CREDENTIALS_ENCRYPTION_KEY=REPLACE_ME_BASE64_32_BYTES

# The deployed frontend's real origin (Netlify/Cloudflare Pages URL, or your custom domain).
# Must be exact -- no trailing slash, no wildcard; the WebSocket gateway reads this same value
# (see SessionsGateway) so getting it wrong breaks HID/video, not just REST CORS.
CORS_ORIGIN=https://REPLACE_ME.netlify.app

AUDIT_FLUSH_INTERVAL_MS=5000
MAX_CONCURRENT_SESSIONS_PER_OPERATOR=3
MEDIA_STREAM_TICKET_TTL_SECONDS=30

# Session snapshots are written to local disk -- on most container hosts (Railway included,
# without an attached volume) this directory is wiped on every redeploy/restart. Fine for a
# demo; if snapshots need to survive redeploys, mount a persistent volume at this path or
# swap SnapshotStorage's implementation for an object-storage-backed one (not built -- see
# docs/architecture.md's "What's intentionally not built").
SNAPSHOT_STORAGE_DIR=./storage/snapshots
SNAPSHOT_INTERVAL_MS=15000

SESSION_IDLE_TIMEOUT_MS=600000
IDLE_SWEEP_INTERVAL_MS=60000
DISABLE_HEALTH_POLLER=false
