# Copy to apps/api/.env for local development. Values here are dev-only placeholders --
# generate fresh secrets for anything beyond a laptop demo (e.g. `openssl rand -hex 32`).

NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://crop:crop_dev_password@localhost:5433/crop
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=dev_access_secret_change_me_dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_dev_refresh_secret_change_me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Must be a base64-encoded 32-byte key: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=BJ5/LxvGnoDUGrcCeWMS8+p1o5igD3s07WGQXVoVELc=

CORS_ORIGIN=http://localhost:5173

AUDIT_FLUSH_INTERVAL_MS=5000
MAX_CONCURRENT_SESSIONS_PER_OPERATOR=3
MEDIA_STREAM_TICKET_TTL_SECONDS=30

# Password reset emails. "file" (the default) appends every outbound email to
# MAIL_OUTBOX_PATH as JSON lines instead of sending anything real -- open that file and copy
# the reset link out by hand. Switch to "resend" + set RESEND_API_KEY/MAIL_FROM to actually
# send mail.
MAILER_DRIVER=file
MAIL_OUTBOX_PATH=./storage/mail-outbox.jsonl
MAIL_FROM=RadLink <no-reply@radlink.med.br>
# Must match wherever `pnpm --filter @crop/web dev` is actually serving from -- this is what
# password-reset links point at.
APP_PUBLIC_URL=http://localhost:5173
PASSWORD_RESET_TTL_SECONDS=900

# Password policy, history, and rotation -- see packages/shared/src/password-policy.ts.
# PASSWORD_MAX_AGE_DAYS=0 disables expiry entirely (checked in User.isPasswordExpired).
PASSWORD_HISTORY_DEPTH=5
PASSWORD_MAX_AGE_DAYS=90
PASSWORD_CHANGE_TTL_SECONDS=600
# How long an "Enviar Convite Seguro" account-activation link stays redeemable.
INVITE_TTL_SECONDS=86400
# The one timezone "today" means for the nursing day-view's "N Pacientes Hoje" query --
# see packages/shared/src/clinic-day.ts.
CLINIC_TIME_ZONE=America/Sao_Paulo
