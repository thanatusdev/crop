# Copy to apps/api/.env for local development. Values here are dev-only placeholders --
# generate fresh secrets for anything beyond a laptop demo (e.g. `openssl rand -hex 32`).

NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://crop:crop_dev_password@localhost:5433/crop
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=dev_access_secret_change_me_dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_dev_refresh_secret_change_me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Must be a base64-encoded 32-byte key: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=BJ5/LxvGnoDUGrcCeWMS8+p1o5igD3s07WGQXVoVELc=

CORS_ORIGIN=http://localhost:5173

AUDIT_FLUSH_INTERVAL_MS=5000
MAX_CONCURRENT_SESSIONS_PER_OPERATOR=3
MEDIA_STREAM_TICKET_TTL_SECONDS=30
